{
  "openapi": "3.0.3",
  "info": {
    "title": "AL API Gateway",
    "description": "Unified API Gateway for Gemini and OpenAI models",
    "version": "1.0.0",
    "contact": {
      "email": "support@siteaccess.ru"
    }
  },
  "servers": [
    {
      "url": "https://api.siteaccess.ru/api/v1",
      "description": "Production API Server"
    }
  ],
  "paths": {
    "/test": {
      "get": {
        "tags": ["Health Check"],
        "summary": "API Health Check",
        "responses": {
          "200": {
            "description": "API is working",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string"},
                    "status": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/process": {
      "post": {
        "tags": ["AI Processing"],
        "summary": "Process AI request",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["provider", "model", "prompt"],
                "properties": {
                  "provider": {"type": "string", "enum": ["gemini", "openai"]},
                  "model": {"type": "string"},
                  "prompt": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "data": {"type": "object"}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
